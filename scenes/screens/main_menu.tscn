[node name="H" type="Label" parent="GuideModal/Margin/VBox/Scroll/Content/CardSol/M/V" unique_id=993821012]
layout_mode = 2
theme_override_colors/font_color = Color(0.235294, 0.890196, 0.85098, 1)
theme_override_fonts/font = ExtResource("3_silk_b")
theme_override_font_sizes/font_size = 13
text = "☀️ WHAT IS A 'SOL'?"

[node name="D" type="Label" parent="GuideModal/Margin/VBox/Scroll/Content/CardSol/M/V" unique_id=993821013]
layout_mode = 2
theme_override_colors/font_color = Color(0.85, 0.9, 0.95, 1)
theme_override_fonts/font = ExtResource("4_silk_r")
theme_override_font_sizes/font_size = 11
text = "A Sol is one Martian day! Because Mars spins slightly slower than Earth, a Sol is 24 hours, 39 minutes, and 35 seconds long. In Martianbound, your mission lasts exactly 1 complete Sol from morning landing to evening extraction!"
autowrap_mode = 2

[node name="CardRad" type="PanelContainer" parent="GuideModal/Margin/VBox/Scroll/Content" unique_id=993821014]
layout_mode = 2
script = ExtResource("5_panel")
is_card = true

[node name="M" type="MarginContainer" parent="GuideModal/Margin/VBox/Scroll/Content/CardRad" unique_id=993821015]
layout_mode = 2
theme_override_constants/margin_left = 12
theme_override_constants/margin_top = 8
theme_override_constants/margin_right = 12
theme_override_constants/margin_bottom = 8

[node name="V" type="VBoxContainer" parent="GuideModal/Margin/VBox/Scroll/Content/CardRad/M" unique_id=993821016]
layout_mode = 2

[node name="H" type="Label" parent="GuideModal/Margin/VBox/Scroll/Content/CardRad/M/V" unique_id=993821017]
layout_mode = 2
theme_override_colors/font_color = Color(0.898039, 0.513726, 0.282353, 1)
theme_override_fonts/font = ExtResource("3_silk_b")
theme_override_font_sizes/font_size = 13
text = "☢️ WHAT IS 'mSv RADIATION'?"

[node name="D" type="Label" parent="GuideModal/Margin/VBox/Scroll/Content/CardRad/M/V" unique_id=993821018]
layout_mode = 2
theme_override_colors/font_color = Color(0.85, 0.9, 0.95, 1)
theme_override_fonts/font = ExtResource("4_silk_r")
theme_override_font_sizes/font_size = 11
text = "Mars doesn't have a thick magnetic shield like Earth, so invisible cosmic rays hit the surface. mSv (milliSievert) measures radiation dose. Safe baseline is 0.22 mSv/h (NASA Curiosity Rover RAD data). If a solar flare hits, it spikes over 0.80 mSv—get inside the Hab dome immediately!"
autowrap_mode = 2

[node name="CardComm" type="PanelContainer" parent="GuideModal/Margin/VBox/Scroll/Content" unique_id=993821019]
layout_mode = 2
script = ExtResource("5_panel")
is_card = true

[node name="M" type="MarginContainer" parent="GuideModal/Margin/VBox/Scroll/Content/CardComm" unique_id=993821020]
layout_mode = 2
theme_override_constants/margin_left = 12
theme_override_constants/margin_top = 8
theme_override_constants/margin_right = 12
theme_override_constants/margin_bottom = 8

[node name="V" type="VBoxContainer" parent="GuideModal/Margin/VBox/Scroll/Content/CardComm/M" unique_id=993821021]
layout_mode = 2

[node name="H" type="Label" parent="GuideModal/Margin/VBox/Scroll/Content/CardComm/M/V" unique_id=993821022]
layout_mode = 2
theme_override_colors/font_color = Color(0.235294, 0.890196, 0.55, 1)
theme_override_fonts/font = ExtResource("3_silk_b")
theme_override_font_sizes/font_size = 13
text = "📡 WHY IS THERE A '14-MINUTE RADIO DELAY'?"

[node name="D" type="Label" parent="GuideModal/Margin/VBox/Scroll/Content/CardComm/M/V" unique_id=993821023]
layout_mode = 2
theme_override_colors/font_color = Color(0.85, 0.9, 0.95, 1)
theme_override_fonts/font = ExtResource("4_silk_r")
theme_override_font_sizes/font_size = 11
text = "Earth and Mars are over 100 million miles apart! Even at light-speed (186,000 miles every second!), a radio message takes 4 to 20 minutes to cross space. If an emergency happens on Mars, Houston cannot remote-control your base—you must think like an astronaut and make decisions yourself!"
autowrap_mode = 2

[node name="CardTradeoff" type="PanelContainer" parent="GuideModal/Margin/VBox/Scroll/Content" unique_id=993821024]
layout_mode = 2
script = ExtResource("5_panel")
is_card = true

[node name="M" type="MarginContainer" parent="GuideModal/Margin/VBox/Scroll/Content/CardTradeoff" unique_id=993821025]
layout_mode = 2
