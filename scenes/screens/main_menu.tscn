[node name="H" type="Label" parent="GuideModal/Margin/VBox/Scroll/Content/CardTradeoff/M/V" unique_id=993821027]
layout_mode = 2
theme_override_colors/font_color = Color(0.905882, 0.352941, 0.352941, 1)
theme_override_fonts/font = ExtResource("3_silk_b")
theme_override_font_sizes/font_size = 13
text = "⚖️ THE GOLDEN RULE OF ENGINEERING: NO FREE LUNCHES!"

[node name="D" type="Label" parent="GuideModal/Margin/VBox/Scroll/Content/CardTradeoff/M/V" unique_id=993821028]
layout_mode = 2
theme_override_colors/font_color = Color(0.85, 0.9, 0.95, 1)
theme_override_fonts/font = ExtResource("4_silk_r")
theme_override_font_sizes/font_size = 11
text = "Every choice has a cost: Shoveling regolith dirt shields against radiation, but tires out your astronauts. Overclocking solar panels generates big battery power, but wears out your capacitors. Pumping ice gives you water, but diverts power away from night heaters!"
autowrap_mode = 2

